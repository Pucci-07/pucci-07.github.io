+{% assign postlist = site.posts %}
+{% assign writeups = postlist | where_exp: "post", "post.platform" %}
+{% assign platforms = writeups | map: "platform" | uniq | sort %}
+
+{% for platform in platforms %}
+{% assign platform_posts = writeups | where: "platform", platform %}
+{% assign machines = platform_posts | group_by: "machine" %}
+
+<section class="writeup-platform" aria-labelledby="platform-{{ platform | slugify }}">
+<h2 class="writeup-platform__title" id="platform-{{ platform | slugify }}">{{ platform }}</h2>
+<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
+{% for machine_group in machines %}
+{% assign card_post = machine_group.items | first %}
+<div class="col">
+<article class="card hoverable writeup-card">
+<a class="writeup-card__image-link" href="{{ card_post.url | relative_url }}" aria-label="Open {{ card_post.machine }} write-up">
+<img
+                  class="writeup-card__image"
+                  src="{{ card_post.thumbnail | relative_url }}"
+                  alt="{{ card_post.machine }} lab cover"
+                  loading="lazy"
+                >
+</a>
+<div class="card-body">
+<p class="writeup-card__platform">{{ platform }}</p>
+<h3 class="writeup-card__title">{{ card_post.machine }}</h3>
+<p class="writeup-card__description">{{ card_post.description }}</p>
+<div class="writeup-card__links" aria-label="Available languages">
+{% for language_post in machine_group.items %}
+<a class="writeup-card__language" href="{{ language_post.url | relative_url }}">
+{{ language_post.language | default: "Read" }}
+</a>
+{% endfor %}
+</div>
+</div>
+</article>
+</div>
+{% endfor %}
+</div>
+</section>
+{% endfor %}
 
